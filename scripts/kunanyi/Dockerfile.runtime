FROM ubuntu:24.04@sha256:008173c23f95b170204355c12626cb5a965d779a7e1283b09e9cffbb1bf33ca3
COPY rootfs/ /
COPY runtime-manifest.json /opt/goal052-runtime-manifest.json
ENV PATH="/data/codex/repos/dSDM/.venv/bin:$PATH" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONNOUSERSITE=1 \
    CUDA_VISIBLE_DEVICES="" \
    OMP_NUM_THREADS=1 \
    OPENBLAS_NUM_THREADS=1 \
    MKL_NUM_THREADS=1
WORKDIR /work
CMD ["/data/codex/repos/dSDM/.venv/bin/python"]
